n = int(input())
stats = {}

for _ in range(n):
    t1, g1, t2, g2 = input().split(";")
    g1, g2 = int(g1), int(g2)

    if t1 not in stats:
        stats[t1] = [0, 0, 0, 0, 0]
    if t2 not in stats:
        stats[t2] = [0, 0, 0, 0, 0]

    stats[t1][0] += 1
    stats[t2][0] += 1

    if g1 > g2:
        stats[t1][1] += 1
        stats[t1][4] += 3
        stats[t2][3] += 1
    elif g1 < g2:
        stats[t2][1] += 1
        stats[t2][4] += 3
        stats[t1][3] += 1
    else:
        stats[t1][2] += 1
        stats[t2][2] += 1
        stats[t1][4] += 1
        stats[t2][4] += 1

for team, s in stats.items():
    print(f"{team}: {s[0]} {s[1]} {s[2]} {s[3]} {s[4]}")
